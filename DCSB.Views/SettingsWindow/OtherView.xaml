<UserControl x:Class="DCSB.Views.SettingsWindow.OtherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DCSB.Views.SettingsWindow"
             xmlns:Utils="clr-namespace:DCSB.Utils;assembly=DCSB.Utils"
             xmlns:Controls="clr-namespace:DCSB.Controls;assembly=DCSB.Controls"
             xmlns:Converters="clr-namespace:DCSB.Converters;assembly=DCSB.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="300"
             d:DesignWidth="400">

    <UserControl.Resources>
        <Converters:VKeysToStringConverter x:Key="vKeysToStringConverter" />
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <GroupBox Header="{DynamicResource Str_Language}">
                <Controls:RadioButtonList SelectedValue="{Binding Language}"
                                          SelectedValuePath="Tag">
                    <ListBoxItem Tag="auto" Content="{DynamicResource Str_LanguageAuto}" />
                    <ListBoxItem Tag="en">English</ListBoxItem>
                    <ListBoxItem Tag="ja">日本語</ListBoxItem>
                </Controls:RadioButtonList>
            </GroupBox>

            <GroupBox Header="{DynamicResource Str_TabOther}">
                <CheckBox IsChecked="{Binding ConfigurationModel.MinimizeToTray}" Content="{DynamicResource Str_MinimizeToTray}" />
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
