<Application x:Class="SB.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary x:Name="ButtonIconDictionary" Source="/SB.Icons;component/Buttons.xaml" />
                <ResourceDictionary x:Name="VolumeIconDictionary" Source="/SB.Icons;component/Volume.xaml" />
                <ResourceDictionary Source="/SB.Icons;component/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
