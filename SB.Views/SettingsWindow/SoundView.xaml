<UserControl x:Class="SB.Views.SettingsWindow.SoundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SB.Views.SettingsWindow"
             xmlns:Controls="clr-namespace:SB.Controls;assembly=SB.Controls"
             xmlns:Converters="clr-namespace:SB.Converters;assembly=SB.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="300"
             d:DesignWidth="400">

    <UserControl.Resources>
        <Converters:VolumeIconConverter x:Key="volumeIconConverter" />
        
        <Style x:Key="ListItem" TargetType="{x:Type ListBoxItem}" >
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" >
                            <ContentPresenter Content = "{TemplateBinding ContentControl.Content}"
                                              ContentTemplate = "{TemplateBinding ContentControl.ContentTemplate}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <GroupBox Header="{DynamicResource Str_OverlapGroup}">
                <CheckBox Margin="5" IsChecked="{Binding Overlap}" Content="{DynamicResource Str_OverlapSounds}" />
            </GroupBox>
            
            <GroupBox Header="{DynamicResource Str_StackGroup}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Str_CopiesLabel}" />
                    <Slider Grid.Row="0" Grid.Column="1" Margin="5" Minimum="1" Maximum="10" TickFrequency="1" SmallChange="1" LargeChange="1"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ToolTip="{DynamicResource Str_StackCountTipApp}"
                            Value="{Binding StackCount}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,5,0" MinWidth="44" VerticalAlignment="Center"
                               Text="{Binding StackCount, StringFormat='×{0}'}" />

                    <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Str_CopyDelayLabel}" />
                    <Slider Grid.Row="1" Grid.Column="1" Margin="5" Minimum="0" Maximum="500" TickFrequency="10" SmallChange="10" LargeChange="10"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ToolTip="{DynamicResource Str_StackOffsetTipApp}"
                            Value="{Binding StackOffset}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,5,0" MinWidth="44" VerticalAlignment="Center"
                               Text="{Binding StackOffset, StringFormat='{}{0} ms'}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource Str_OutputDevices}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    
                    <Label Grid.Column="0"
                           Grid.Row="0" Content="{DynamicResource Str_FirstDevice}" />
                    <ComboBox Grid.Column="1"
                              Grid.Row="0"
                              Margin="3"
                              ItemsSource="{Binding AvailableOutputs}"
                              SelectedItem="{Binding PrimaryOutput}" />
                    <DockPanel Grid.Column="1"
                               Grid.Row="1"
                               Margin="0,0,0,5">
                        <Controls:IconButton DockPanel.Dock="Left"
                                             Margin="3,0,0,0"
                                             Content="{Binding ElementName=PrimaryVolumeSlider, Path=Value, Converter={StaticResource volumeIconConverter}, ConverterParameter={StaticResource VolumeIcons}}" 
                                             Command="{Binding MutePrimaryCommand}"
                                             Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                             Height="{Binding ActualHeight, ElementName=PrimaryVolumeSlider}">
                            <Controls:IconButton.Style>
                                <Style TargetType="{x:Type Controls:IconButton}">
                                    <Style.Setters>
                                        <Setter Property="ToolTip" Value="{DynamicResource Str_Mute}" />
                                    </Style.Setters>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Value, ElementName=PrimaryVolumeSlider}" Value="0">
                                            <Setter Property="ToolTip" Value="{DynamicResource Str_Unmute}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Controls:IconButton.Style>
                        </Controls:IconButton>
                        <Slider x:Name="PrimaryVolumeSlider"
                                Margin="3"
                                DockPanel.Dock="Right"
                                Maximum="100"
                                IsMoveToPointEnabled="True"
                                AutoToolTipPlacement="BottomRight"
                                Value="{Binding PrimaryDeviceVolume}" />
                    </DockPanel>

                    <Label Grid.Column="0" 
                           Grid.Row="2" Content="{DynamicResource Str_SecondDevice}" />
                    <ComboBox Grid.Column="1" 
                              Grid.Row="2"
                              Margin="3"
                              ItemsSource="{Binding AvailableOutputs}" 
                              SelectedItem="{Binding SecondaryOutput}" />
                    <DockPanel Grid.Column="1"
                               Grid.Row="3">
                        <Controls:IconButton DockPanel.Dock="Left"
                                             Margin="3,0,0,0"
                                             Content="{Binding ElementName=SecondaryVolumeSlider, Path=Value, Converter={StaticResource volumeIconConverter}, ConverterParameter={StaticResource VolumeIcons}}" 
                                             Command="{Binding MuteSecondaryCommand}"
                                             Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                             Height="{Binding ActualHeight, ElementName=SecondaryVolumeSlider}">
                            <Controls:IconButton.Style>
                                <Style TargetType="{x:Type Controls:IconButton}">
                                    <Style.Setters>
                                        <Setter Property="ToolTip" Value="{DynamicResource Str_Mute}" />
                                    </Style.Setters>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Value, ElementName=SecondaryVolumeSlider}" Value="0">
                                            <Setter Property="ToolTip" Value="{DynamicResource Str_Unmute}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Controls:IconButton.Style>
                        </Controls:IconButton>
                        <Slider x:Name="SecondaryVolumeSlider"
                                Margin="3"
                                DockPanel.Dock="Right"
                                Maximum="100"
                                IsMoveToPointEnabled="True"
                                AutoToolTipPlacement="BottomRight"
                                Value="{Binding SecondaryDeviceVolume}" />
                    </DockPanel>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
