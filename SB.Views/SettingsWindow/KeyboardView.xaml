<UserControl x:Class="SB.Views.SettingsWindow.KeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SB.Views.SettingsWindow"
             xmlns:Converters="clr-namespace:SB.Converters;assembly=SB.Converters"
             xmlns:Interactivity="clr-namespace:SB.Interactivity;assembly=SB.Interactivity"
             xmlns:Controls="clr-namespace:SB.Controls;assembly=SB.Controls"
             xmlns:Utils="clr-namespace:SB.Utils;assembly=SB.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="300"
             d:DesignWidth="400">

    <UserControl.Resources>
        <Converters:VKeysToStringConverter x:Key="vKeysToStringConverter" />
        <Converters:EqualsParameterConverter x:Key="areEqualConverter" />
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <GroupBox Header="{DynamicResource Str_Sounds}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Str_PlaySelectedLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="2" IsReadOnly="True" Cursor="Arrow" VerticalContentAlignment="Center"
                             ToolTip="{DynamicResource Str_PlaySelectedTip}"
                             Text="{Binding ConfigurationModel.SoundShortcuts.PlaySelected.Keys, Converter={StaticResource vKeysToStringConverter}}"
                             Interactivity:Commands.DoubleClickCommand="{Binding BindKeysCommand}"
                             Interactivity:Commands.DoubleClickCommandParameter="{Binding ConfigurationModel.SoundShortcuts.PlaySelected}" />
                    <Button Grid.Row="0" Grid.Column="2" Margin="0,2,2,2" Width="20" Command="{Binding BindKeysCommand}" 
                            CommandParameter="{Binding ConfigurationModel.SoundShortcuts.PlaySelected}">...</Button>

                    <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Str_PauseLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="2" IsReadOnly="True" Cursor="Arrow" VerticalContentAlignment="Center"
                             Text="{Binding ConfigurationModel.SoundShortcuts.Pause.Keys, Converter={StaticResource vKeysToStringConverter}}"
                             Interactivity:Commands.DoubleClickCommand="{Binding BindKeysCommand}"
                             Interactivity:Commands.DoubleClickCommandParameter="{Binding ConfigurationModel.SoundShortcuts.Pause}" />
                    <Button Grid.Row="1" Grid.Column="2" Margin="0,2,2,2" Width="20" Command="{Binding BindKeysCommand}" 
                            CommandParameter="{Binding ConfigurationModel.SoundShortcuts.Pause}">...</Button>

                    <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource Str_ContinueLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="2" IsReadOnly="True" Cursor="Arrow" VerticalContentAlignment="Center"
                             Text="{Binding ConfigurationModel.SoundShortcuts.Continue.Keys, Converter={StaticResource vKeysToStringConverter}}"
                             Interactivity:Commands.DoubleClickCommand="{Binding BindKeysCommand}"
                             Interactivity:Commands.DoubleClickCommandParameter="{Binding ConfigurationModel.SoundShortcuts.Continue}" />
                    <Button Grid.Row="2" Grid.Column="2" Margin="0,2,2,2" Width="20" Command="{Binding BindKeysCommand}" 
                            CommandParameter="{Binding ConfigurationModel.SoundShortcuts.Continue}">...</Button>

                    <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource Str_StopLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="2" IsReadOnly="True" Cursor="Arrow" VerticalContentAlignment="Center"
                             Text="{Binding ConfigurationModel.SoundShortcuts.Stop.Keys, Converter={StaticResource vKeysToStringConverter}}"
                             Interactivity:Commands.DoubleClickCommand="{Binding BindKeysCommand}"
                             Interactivity:Commands.DoubleClickCommandParameter="{Binding ConfigurationModel.SoundShortcuts.Stop}" />
                    <Button Grid.Row="3" Grid.Column="2" Margin="0,2,2,2" Width="20" Command="{Binding BindKeysCommand}" 
                            CommandParameter="{Binding ConfigurationModel.SoundShortcuts.Stop}">...</Button>
                </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource Str_PresetsGroup}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Str_NextPresetLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="2" IsReadOnly="True" Cursor="Arrow" VerticalContentAlignment="Center"
                             ToolTip="{DynamicResource Str_PresetKeysTip}"
                             Text="{Binding ConfigurationModel.SoundShortcuts.NextPreset.Keys, Converter={StaticResource vKeysToStringConverter}}"
                             Interactivity:Commands.DoubleClickCommand="{Binding BindKeysCommand}"
                             Interactivity:Commands.DoubleClickCommandParameter="{Binding ConfigurationModel.SoundShortcuts.NextPreset}" />
                    <Button Grid.Row="0" Grid.Column="2" Margin="0,2,2,2" Width="20" Command="{Binding BindKeysCommand}"
                            CommandParameter="{Binding ConfigurationModel.SoundShortcuts.NextPreset}">...</Button>

                    <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Str_PreviousPresetLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="2" IsReadOnly="True" Cursor="Arrow" VerticalContentAlignment="Center"
                             ToolTip="{DynamicResource Str_PresetKeysTip}"
                             Text="{Binding ConfigurationModel.SoundShortcuts.PreviousPreset.Keys, Converter={StaticResource vKeysToStringConverter}}"
                             Interactivity:Commands.DoubleClickCommand="{Binding BindKeysCommand}"
                             Interactivity:Commands.DoubleClickCommandParameter="{Binding ConfigurationModel.SoundShortcuts.PreviousPreset}" />
                    <Button Grid.Row="1" Grid.Column="2" Margin="0,2,2,2" Width="20" Command="{Binding BindKeysCommand}"
                            CommandParameter="{Binding ConfigurationModel.SoundShortcuts.PreviousPreset}">...</Button>
                </Grid>
            </GroupBox>

            <GroupBox Header="{DynamicResource Str_WheelGroup}">
                <StackPanel>
                    <Controls:RadioButtonList SelectedValue="{Binding WheelMode}"
                                              SelectedValuePath="Tag">
                        <ListBoxItem Tag="{x:Static Utils:WheelMode.WithModifier}" Content="{DynamicResource Str_WheelWithModifier}" />
                        <ListBoxItem Tag="{x:Static Utils:WheelMode.Always}" Content="{DynamicResource Str_WheelAlways}" />
                        <ListBoxItem Tag="{x:Static Utils:WheelMode.Disabled}" Content="{DynamicResource Str_WheelDisabled}" />
                    </Controls:RadioButtonList>

                    <Grid IsEnabled="{Binding WheelMode, Converter={StaticResource areEqualConverter}, ConverterParameter={x:Static Utils:WheelMode.WithModifier}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Str_ModifierLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="2" IsReadOnly="True" Cursor="Arrow" VerticalContentAlignment="Center"
                                 ToolTip="{DynamicResource Str_ModifierTip}"
                                 Text="{Binding ConfigurationModel.SoundShortcuts.WheelModifier.Keys, Converter={StaticResource vKeysToStringConverter}}"
                                 Interactivity:Commands.DoubleClickCommand="{Binding BindKeysCommand}"
                                 Interactivity:Commands.DoubleClickCommandParameter="{Binding ConfigurationModel.SoundShortcuts.WheelModifier}" />
                        <Button Grid.Row="0" Grid.Column="2" Margin="0,2,2,2" Width="20" Command="{Binding BindKeysCommand}" 
                                CommandParameter="{Binding ConfigurationModel.SoundShortcuts.WheelModifier}">...</Button>
                    </Grid>

                    <CheckBox Margin="2,4" IsChecked="{Binding ConfigurationModel.ShowSelectionOverlay}" Content="{DynamicResource Str_ShowOverlay}" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
