<UserControl x:Class="SB.Views.SoundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Converters="clr-namespace:SB.Converters;assembly=SB.Converters"
             xmlns:Interactivity="clr-namespace:SB.Interactivity;assembly=SB.Interactivity"
             Width="500">

    <UserControl.Resources>
        <Converters:ConcatStringsConverter x:Key="concatStringsConverter" />
        <Converters:VKeysToStringConverter x:Key="vKeysToStringConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Str_NameLabel}" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Text="{Binding ApplicationStateModel.ModifiedSound.Name}" />

        <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Str_FilesLabel}" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="True" AcceptsReturn="True" MaxHeight="250" 
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Cursor="Arrow"
                 Text="{Binding ApplicationStateModel.ModifiedSound.Files, Converter={StaticResource concatStringsConverter}, ConverterParameter='&#x0a;'}"
                 Interactivity:Commands.DoubleClickCommand="{Binding OpenSoundFileDialogCommand}" />
        <Button Grid.Row="1" Grid.Column="2" Margin="0,5,5,5" Width="20" Command="{Binding OpenSoundFileDialogCommand}">...</Button>

        <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource Str_KeysLabel}" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="5" IsReadOnly="True"
                 Text="{Binding ApplicationStateModel.ModifiedSound.Keys, Converter={StaticResource vKeysToStringConverter}}"
                 Interactivity:Commands.DoubleClickCommand="{Binding BindKeysCommand}"
                 Interactivity:Commands.DoubleClickCommandParameter="{Binding ApplicationStateModel.ModifiedSound}" />
        <Button Grid.Row="2" Grid.Column="2" Margin="0,5,5,5" Width="20" Command="{Binding BindKeysCommand}" 
                CommandParameter="{Binding ApplicationStateModel.ModifiedSound}">...</Button>

        <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource Str_VolumeLabel}" />
        <Slider Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="5" Maximum="100" AutoToolTipPlacement="BottomRight"
                IsMoveToPointEnabled="True" ToolTip="{DynamicResource Str_AppliesNextPlay}"
                Value="{Binding ApplicationStateModel.ModifiedSound.Volume}"/>

        <Label Grid.Row="4" Grid.Column="0" Content="{DynamicResource Str_LoopLabel}" />
        <CheckBox Grid.Row="4" Grid.Column="1" Margin="5" ToolTip="{DynamicResource Str_AppliesNextPlay}"
                  IsChecked="{Binding ApplicationStateModel.ModifiedSound.Loop}" />

        <Label Grid.Row="5" Grid.Column="0" Content="{DynamicResource Str_CopiesLabel}" />
        <Slider Grid.Row="5" Grid.Column="1" Margin="5" Minimum="1" Maximum="10" TickFrequency="1" SmallChange="1" LargeChange="1"
                IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ToolTip="{DynamicResource Str_CopiesTip}"
                Value="{Binding ApplicationStateModel.ModifiedSound.Copies}" />
        <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,0,5,0" MinWidth="44" VerticalAlignment="Center"
                   Text="{Binding ApplicationStateModel.ModifiedSound.Copies, StringFormat='×{0}'}" />

        <Label Grid.Row="6" Grid.Column="0" Content="{DynamicResource Str_CopyDelayLabel}" />
        <Slider Grid.Row="6" Grid.Column="1" Margin="5" Minimum="0" Maximum="500" TickFrequency="10" SmallChange="10" LargeChange="10"
                IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ToolTip="{DynamicResource Str_CopyDelayTip}"
                Value="{Binding ApplicationStateModel.ModifiedSound.CopyDelay}" />
        <TextBlock Grid.Row="6" Grid.Column="2" Margin="0,0,5,0" MinWidth="44" VerticalAlignment="Center"
                   Text="{Binding ApplicationStateModel.ModifiedSound.CopyDelay, StringFormat='{}{0} ms'}" />
    </Grid>
</UserControl>
