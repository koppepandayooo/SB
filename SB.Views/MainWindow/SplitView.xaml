<UserControl x:Class="SB.Views.MainWindow.SplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SB.Views.MainWindow"
             xmlns:Converters="clr-namespace:SB.Converters;assembly=SB.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="300"
             d:DesignWidth="400">

    <UserControl.Resources>
        <Converters:AreEqualConverter x:Key="AreEqualConverter" />
        <Converters:VKeysToStringConverter x:Key="vKeysToStringConverter" />

    </UserControl.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            
            <MenuItem Header="{DynamicResource Str_Settings}" 
                      Command="{Binding OpenSettingsCommand}" />
            
            <MenuItem Header="{Binding ConfigurationModel.SelectedPreset.Name}" 
                      HeaderStringFormat="{DynamicResource Str_PresetFormat}"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding ConfigurationModel.PresetCollection}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Command" Value="{Binding DataContext.PresetSelectedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        <Setter Property="CommandParameter" Value="{Binding}" />
                        <Setter Property="InputGestureText" Value="{Binding Keys, Converter={StaticResource vKeysToStringConverter}}" />
                        <Setter Property="IsChecked">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource AreEqualConverter}">
                                    <Binding Path="DataContext.ConfigurationModel.SelectedPreset" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                    <Binding Path="."/>
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>

            <MenuItem Header="{DynamicResource Str_NotAdmin}" 
                      Visibility="{Binding NotAdministrator}" 
                      Command="{Binding OpenNotAdministratorCommand}" />

            <MenuItem Header="{DynamicResource Str_Help}"
                      HorizontalAlignment="Right">
                <MenuItem Header="{DynamicResource Str_About}" 
                          Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>

        <local:SoundListView />

    </DockPanel>
</UserControl>
